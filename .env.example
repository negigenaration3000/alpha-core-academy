# ==============================================================================
# ALPHA-CORE ACADEMY — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Your Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anonymous Public API Key (Safe for client browsers)
# NEVER put the service_role secret key here!
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Default currency configuration
VITE_DEFAULT_CURRENCY=BDT
VITE_DEFAULT_CURRENCY_SYMBOL=৳
